# Copy to apps/api/.env.local for local builds only. Never commit real values.
APP_ENV=local
CLIENT_ORIGINS=http://localhost:3000
AUTH_ENABLED=false
DATABASE_ENABLED=false
PRIVILEGED_DATA_ENABLED=false
KAP_ENABLED=false
# Required when AUTH_ENABLED=true:
# CLERK_SECRET_KEY=
# CLERK_JWT_ISSUER=
# Required when DATABASE_ENABLED=true:
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# Required only when PRIVILEGED_DATA_ENABLED=true (also needs DATABASE_ENABLED):
# SUPABASE_SECRET_KEY=
# Required when KAP_ENABLED=true; basic additionally requires KAP_API_SECRET:
# KAP_ENV=
# KAP_BASE_URL=
# KAP_AUTH_MODE=
# KAP_API_KEY=
# KAP_API_SECRET=
