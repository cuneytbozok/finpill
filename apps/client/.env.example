# Copy to apps/client/.env.local for local builds only. Values are public.
NEXT_PUBLIC_APP_ENV=local
# Enable only when a real API target is configured.
NEXT_PUBLIC_API_ENABLED=false
# NEXT_PUBLIC_API_ORIGIN=http://localhost:3001
# Native release builds only: set after the HTTPS association host is deployed.
# NEXT_PUBLIC_DEEP_LINK_ORIGIN=https://finpill.vercel.app
NEXT_PUBLIC_AUTH_ENABLED=false
# Set only when enabling authentication; never put a secret key here.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
